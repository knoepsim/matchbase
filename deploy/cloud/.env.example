# MatchBase Cloud (deploy/cloud/docker-compose.yml). Copy to deploy/cloud/.env (not committed) and fill in.
# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
SECRET_KEY=

# :80 = plain HTTP behind cloudflared or another proxy that terminates TLS; a domain = HTTPS by Caddy
SITE_ADDRESS=:80

# Phone numbers (comma separated, +49...) that are system admins
SUPER_ADMIN_PHONES=

# production refuses to start with SMS_BACKEND=dummy (every login code is 123456). Until a real SMS backend exists,
# only ENVIRONMENT=development starts, and then anybody can log in with any number: not for public use.
ENVIRONMENT=production
SMS_BACKEND=dummy
