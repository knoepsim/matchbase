# One MatchBase Cloud instance (deploy/cloud/docker-compose.yml). Copy per instance, e.g. to deploy/cloud/prod.env and
# deploy/cloud/dev.env (*.env in deploy/ is not committed), and fill in. Generate secrets with: openssl rand -hex 32

# Name of the instance: project name and volumes, and the address in the tunnel network (http://<INSTANCE>:80)
INSTANCE=matchbase-prod
# Image tag the instance follows: latest = releases, dev = every merge into dev, or a fixed one like 0.2
MATCHBASE_TAG=latest

POSTGRES_PASSWORD=
SECRET_KEY=

# :80 = plain HTTP behind cloudflared or another proxy that terminates TLS; a domain = HTTPS by Caddy (expose.yml)
SITE_ADDRESS=:80

# Phone numbers (comma separated, +49...) that are system admins
SUPER_ADMIN_PHONES=

# production refuses to start with SMS_BACKEND=dummy (every login code is 123456). Until a real SMS backend exists,
# only ENVIRONMENT=development starts, and then anybody can log in with any number: put Cloudflare Access in front.
ENVIRONMENT=production
SMS_BACKEND=dummy
